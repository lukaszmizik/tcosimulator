{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "tacho-viewer-ddd-parser": ["src/types/tachoViewerDddParser.d.ts"],
      "tacho-viewer-ddd-mapper": ["src/types/tachoViewerDddMapper.d.ts"],
      "tacho-viewer-graph": ["src/types/tachoViewerGraph.d.ts"],
      "tacho-viewer-card-graph": ["src/types/tachoViewerGraph.d.ts"],
      "tacho-viewer-language": ["src/types/tachoViewerGraph.d.ts"],
      "tacho-viewer-slot-graph": ["src/types/tachoViewerGraph.d.ts"]
    }
  },
  "include": ["src"]
}
